[
    The Cactus Programming Language's Parser & Lexer (Larser)
]

[
    Larsing Workspace
]
[ workspace ]
!cactus.larsing.workspace(
    current_files !df.current, [ multiple files ]
    current_file !df.current, [ only one file ]
    current_text_location !df.text.location
)

[
    Larsing - Larsing
]

[ larse program ]
cactus.larse(user_code !df.buffer)(output !cactus.larsling.program, error !df.error) = {
    [ setup constants ]
    df.pack.null()(dummy.buffer !df.buffer)
    df.pack.null()(dummy.structure_definition !cactus.larsling.structure)
    df.pack.null()(dummy.structure_argument !cactus.larsling.structure.argument)
    df.structure.byte_size(dummy.buffer)(buffer.byte_size)
    df.structure.byte_size(dummy.structure_definition)(structure_definition.byte_size)
    df.structure.byte_size(dummy.structure_argument)(structure_argument.byte_size)
    df.set(df.hexadecimal.28)(left_parenthesis)
    df.set(df.hexadecimal.29)(right_parenthesis)
    df.set(df.hexadecimal.21)(exclamation_point)
    df.set(df.hexadecimal.3D)(equals_sign)

    [ open program ]
    cactus.open.larsling.program()(output)

    [ setup workspace ]
    df.pack.null()(workspace !cactus.larsing.workspace)
    df.pack(user_code, user_code:start)(workspace:current_files !df.current)
    df.error.setup_blank()(error)

    [ loop over all files ]
    @larse.all_files df.always = {
        [ check for files ]
        df.current.within_range(workspace:current_files)(in_range, out_of_range)
        df.jump.bottom(out_of_range, @larse.all_files)()

        [ get file ]
        df.buffer.calculate.end_address(workspace:current_files:progress, buffer.byte_size)(current_files.end)
        df.pack(workspace:current_files:progress, current_files.end)(current_files.as_buffer !df.buffer)
        df.buffer_to_structure(current_files.as_buffer)(file !df.buffer)

        [ setup current file ]
        df.pack(file, file:start)(workspace:current_file !df.current)

        [ check to see if file is empty ]
        df.integer.within_range(file:start, file:start, file:end)(in_range, out_of_range)
        df.jump.bottom(out_of_range, @larse.one_file)()

        [ reset text location line number & character index ]
        df.copy(df.constant.1)(workspace:current_text_location:line_number)
        df.copy(df.constant.0)(workspace:current_text_location:character_index)

        [ loop over file characters ]
        @larse.one_file df.always = {
            [ check for exclamation point ]
            cactus.larse.check_for_character(workspace, exclamation_point, exclamation_point, df.false, error)(workspace, ran_out_of_characters, found, not_found, error)
            df.jump.bottom(ran_out_of_characters, @df.master_scope)()
            df.jump.bottom(error:occured, @df.master_scope)()
            @larse.one_file.search.data_definition.exclamation_point found = {
                [ larse for a type ]
                df.set("Larsing Error: When searching for an alias or a structure definition, the type definition name was not found.")(message)
                cactus.larse.type(workspace, message, error)(workspace, data_definition_name, ran_out_of_characters, found, not_found, error)
                df.jump.bottom(ran_out_of_characters, @df.master_scope)()
                df.jump.bottom(error:occured, @df.master_scope)()

                [ check for equals sign ]
                cactus.larse.check_for_character(workspace, equals_sign, equals_sign, df.true, error)(workspace, ran_out_of_characters, found, not_found, error)
                df.jump.bottom(ran_out_of_characters, @df.master_scope)()
                df.jump.bottom(error:occured, @df.master_scope)()
                @larse.one_file.search.data_definition.equals_sign.not_found not_found = {
                    [ error ]
                    df.set("Larsing Error: When searching for the equals sign of an alias or a structure definition, it was not found.")(message)
                    df.error.generate(message, workspace:current_text_location)(error)

                    [ quit ]
                    df.jump.bottom(error:occured, @df.master_scope)()
                }

                [ check for exclamation point ]
                cactus.larse.check_for_character(workspace, exclamation_point, exclamation_point, df.false, error)(workspace, ran_out_of_characters, found, not_found, error)
                df.jump.bottom(ran_out_of_characters, @df.master_scope)()
                df.jump.bottom(error:occured, @df.master_scope)()
                @larse.one_file.search.data_content.alias_new_name found = {
                    [ larse for a type ]
                    df.set("Larsing Error: When searching for an alias's new name, the name was not found.")(message)
                    cactus.larse.type(workspace, message, error)(workspace, data_definition_alias, ran_out_of_characters, found, not_found, error)
                    df.jump.bottom(ran_out_of_characters, @larse.one_file)()
                    df.jump.bottom(error:occured, @df.master_scope)()

                    [ found alias, append it ]
                    df.pack(data_definition_name, data_definition_alias)(alias !cactus.larsling.alias)
                    cactus.list.append.larsling.alias(output:aliases, alias)(output:aliases)

                    [ DEBUG ]
                    cactus.larse.print.alias(alias)()
                    df.print.new_line()()

                    [ next item to larse ]
                    df.jump.top(df.always, @larse.one_file)()
                }

                [ check for left parenthesis ]
                cactus.larse.check_for_character(workspace, left_parenthesis, left_parenthesis, df.true, error)(workspace, ran_out_of_characters, found, not_found, error)
                df.jump.bottom(ran_out_of_characters, @df.master_scope)()
                df.jump.bottom(error:occured, @df.master_scope)()
                @larse.one_file.search.data_content.structure_definition found = {
                    [ create list for members ]
                    df.integer.multiply(df.constant.32, structure_argument.byte_size)(increase)
                    df.list.open(increase)(structure_members)

                    [ setup argument counter ]
                    df.copy(df.constant.0)(argument_count)

                    [ search for members ]
                    @larse.one_file.search.data_content.structure_definition.member_definition df.always = {
                        [ check for closing right parenthesis ]
                        cactus.larse.check_for_character(workspace, right_parenthesis, right_parenthesis, df.true, error)(workspace, ran_out_of_characters, found, not_found, error)
                        df.jump.bottom(ran_out_of_characters, @df.master_scope)()
                        df.jump.bottom(error:occured, @df.master_scope)()
                        @larse.one_file.search.data_content.structure_definition.finished found = {
                            [ check for zero members ]
                            df.integer.within_range(df.constant.0, argument_count, df.constant.0)(no_arguments, one_or_more_arguments)
                            @larse.one_file.search.data_content.structure_definition.no_members no_arguments = {
                                [ raise error ]
                                df.set("Larsing Error: A structure definition had zero arguments (members).")(error_message)
                                df.error.generate(error_message, workspace:current_text_location)(error)

                                [ quit ]
                                df.jump.bottom(df.always, @df.master_scope)()
                            }

                            [ create structure ]
                            df.pack(data_definition_name, structure_members)(structure !cactus.larsling.structure)

                            [ DEBUG ]
                            cactus.larse.print.structure(structure)()
                            df.print.new_line()()

                            [ append structure ]
                            cactus.list.append.larsling.structure(output:structures, structure)(output:structures)

                            [ next item ]
                            df.jump.top(df.always, @larse.one_file)()
                        }

                        [ larse member definition ]
                        cactus.larse.structure.argument(workspace, argument_count, error)(workspace, argument, ran_out_of_characters, found, not_found, error)
                        df.jump.bottom(ran_out_of_characters, @df.master_scope)()
                        df.jump.bottom(error:occured, @df.master_scope)()
                        
                        [ raise error if not found ]
                        @larse.one_file.search.data_definition.error.structure_argument.not_found not_found = {
                            [ raise error ]
                            df.set("Larsing Error: When searching for a structure argument inside a structure definition, a structure argument or a closing parenthesis was not found.")(error_message)
                            df.error.generate(error_message, workspace:current_text_location)(error)

                            [ quit ]
                            df.jump.bottom(df.always, @df.master_scope)()
                        }

                        [ append structure argument ]
                        cactus.list.append.larsling.structure.argument(structure_members, argument)(structure_members)

                        [ next agrument count ]
                        df.integer.add(argument_count, df.constant.1)(argument_count)

                        [ jump to loop start, next argument to find ]
                        df.jump.top(df.always, @larse.one_file.search.data_content.structure_definition.member_definition)()
                    }
                }

                [ error, invalid syntax ]
                df.set("Larsing Error: When searching for either an alias definition or structure definition after finding the equals sign, neither was found.")(error_message)
                df.error.generate(error_message, workspace:current_text_location)(error)

                [ quit ]
                df.jump.bottom(error:occured, @df.master_scope)()
            }

            [ search for name character ]
            cactus.larse.name(workspace)(workspace, function_name, ran_out_of_characters, found, not_found)

            [ parse function if found name ]
            @larse.one_file.search.function_name found = {
                [ get input and output arguments ]
                [ todo ]
            }

            [ otherwise, error ]
            df.set("Larsing Error: When searching for something to larse at the file scope level, cactus couldn't figure out what to larse at the line number specified.")(error_message)
            df.error.generate(error_message, workspace:current_text_location)(error)

            [ quit ]
            df.jump.bottom(error:occured, @df.master_scope)()
        }

        [ advance files current ]
        df.integer.add(workspace:current_files:progress, buffer.byte_size)(workspace:current_files:progress)

        [ next file index ]
        df.integer.add(workspace:current_text_location:file_index, df.constant.1)(workspace:current_text_location:file_index)

        [ next file larse ]
        df.jump.top(df.always, @larse.all_files)()
    }

    [ exit ]
}

[ larse a structure definition argument ]
cactus.larse.structure.argument(workspace !cactus.larsing.workspace, argument_index !df.cell, error !df.error)(workspace !cactus.larsing.workspace, argument !cactus.larsling.structure.argument, ran_out_of_characters !df.cell, found !df.cell, not_found !df.cell, error !df.error) = {
    [ setup constants ]
    df.set(df.hexadecimal.2C)(comma)

    [ check for first argument (so it doesn't require a preceeding comma) ]
    df.integer.within_range(df.constant.0, argument_index, df.constant.0)(is_first_argument, not_first_argument)
    @larse.structure_argument.is_first_argument not_first_argument = {
        [ check for comma ]
        cactus.larse.check_for_character(workspace, comma, comma, df.true, error)(workspace, ran_out_of_characters, found, not_found, error)
        df.jump.bottom(ran_out_of_characters, @df.master_scope)()
        df.jump.bottom(error:occured, @df.master_scope)()

        [ comma not found ]
        @larse.structure_argument.comma_missing not_found = {
            [ error ]
            df.set("Larsing Error: Was searching for the next structure member definition but no comma was found to separate it. Nor was the arguments' closer found.")(error_message)
            df.error.generate(error_message, workspace:current_text_location)(error)

            [ quit ]
            df.jump.bottom(error:occured, @df.master_scope)()
        }
    }

    [ skip whitespace ]
    cactus.larse.skip_whitespace(workspace, error)(workspace, ran_out_of_characters, error)
    df.jump.bottom(ran_out_of_characters, @df.master_scope)()
    df.jump.bottom(error:occured, @df.master_scope)()

    [ get & check name ]
    cactus.larse.name(workspace)(workspace, argument.name, ran_out_of_characters, found, not_found)
    @larse.structure_argument.name.not_found not_found = {
        [ error ]
        df.set("Larsing Error: Missing structure argument member name.")(error_message)
        df.error.generate(error_message, workspace:current_text_location)(error)

        [ quit ]
        df.jump.bottom(error:occured, @df.master_scope)()
    }

    [ get type ]
    df.set("Larsing Error: Missing structure argument member type.")(message)
    cactus.larse.type(workspace, message, error)(workspace, argument.type, ran_out_of_characters, found, not_found, error)
    df.jump.bottom(ran_out_of_characters, @df.master_scope)()
    df.jump.bottom(error:occured, @df.master_scope)()

    [ pack data ]
    df.pack(argument.name, argument.type)(argument !cactus.larsling.structure.argument)
}

[ larse a type ]
cactus.larse.type(workspace !cactus.larsing.workspace, error_message !df.buffer, error !df.error)(workspace !cactus.larsing.workspace, text !cactus.larsling.text, ran_out_of_characters !df.cell, found !df.cell, not_found !df.cell, error !df.error) = {
    [ setup constants ]
    df.set(df.hexadecimal.21)(exclamation_point)
    
    [ check for exclamation point ]
    cactus.larse.check_for_character(workspace, exclamation_point, exclamation_point, df.true, error)(workspace, ran_out_of_characters, found, not_found, error)
    df.jump.bottom(ran_out_of_characters, @df.master_scope)()
    df.jump.bottom(error:occured, @df.master_scope)()
    @larse.type.exclamation_point.found found = {
        [ skip whitespace ]
        cactus.larse.skip_whitespace(workspace, error)(workspace, ran_out_of_characters, error)
        df.jump.bottom(ran_out_of_characters, @df.master_scope)()
        df.jump.bottom(error:occured, @df.master_scope)()

        [ get & check name ]
        cactus.larse.name(workspace)(workspace, text, ran_out_of_characters, found, not_found)
        @larse.type.name.not_found not_found = {
            [ error ]
            df.error.generate(error_message, workspace:current_text_location)(error)

            [ quit ]
            df.jump.bottom(error:occured, @df.master_scope)()
        }

        [ found, exit function ]
        df.jump.bottom(df.always, @df.master_scope)()
    }
    @larse.type.exclamation_point.not_found not_found = {
        [ error ]
        df.error.generate(error_message, workspace:current_text_location)(error)

        [ quit ]
        df.jump.bottom(error:occured, @df.master_scope)()
    }
}

[ larse a name ]
cactus.larse.name(workspace !cactus.larsing.workspace)(workspace !cactus.larsing.workspace, text !cactus.larsling.text, ran_out_of_characters !df.cell, found !df.cell, not_found !df.cell) = {
    [ setup characters ]
    df.set(df.hexadecimal.61)(lowercase.start)
    df.set(df.hexadecimal.7A)(lowercase.end)
    df.set(df.hexadecimal.41)(uppercase.start)
    df.set(df.hexadecimal.5A)(uppercase.end)
    df.set(df.hexadecimal.30)(decimal_digits.start)
    df.set(df.hexadecimal.39)(decimal_digits.end)
    df.set(df.hexadecimal.5F)(underscore)
    df.set(df.hexadecimal.2E)(period)

    [ setup text start ]
    df.integer.subtract(workspace:current_file:progress, df.constant.1)(progress.end)
    df.pack(workspace:current_file:progress, progress.end)(text:value !df.buffer)
    df.copy(workspace:current_text_location)(text:location)
    df.copy(df.false)(found)
    df.copy(df.true)(not_found)

    [ check characters ]
    @check_characters df.always = {
        [ make sure there are more characters to read ]
        df.current.within_range(workspace:current_file)(in_range, ran_out_of_characters)
        @ran_out_of_characters ran_out_of_characters = {
            [ if not, quit ]
            df.jump.bottom(ran_out_of_characters, @df.master_scope)()
        }

        [ get character ]
        df.address_to_cell(workspace:current_file:progress, df.ascii_character.byte_size)(character, advancement)

        [ check character ]
        df.integer.within_range(lowercase.start, character, lowercase.end)(in_range, out_of_range)
        df.jump(in_range, @found_character)()
        df.integer.within_range(uppercase.start, character, uppercase.end)(in_range, out_of_range)
        df.jump(in_range, @found_character)()
        df.integer.within_range(decimal_digits.start, character, decimal_digits.end)(in_range, out_of_range)
        df.jump(in_range, @found_character)()
        df.integer.within_range(underscore, character, underscore)(in_range, out_of_range)
        df.jump(in_range, @found_character)()
        df.integer.within_range(period, character, period)(in_range, out_of_range)
        df.jump(in_range, @found_character)()

        [ did not find character, quit loop ]
        df.jump.bottom(df.always, @df.master_scope)()

        [ found character ]
        @found_character

        [ update output ]
        df.copy(df.true)(found)
        df.copy(df.false)(not_found)

        [ advance text ]
        df.integer.add(text:value:end, df.ascii_character.byte_size)(text:value:end)

        [ advance current ]
        df.integer.add(workspace:current_file:progress, df.ascii_character.byte_size)(workspace:current_file:progress)

        [ jump to loop start ]
        df.jump.top(df.always, @check_characters)()
    }
}

[ check for a character ]
cactus.larse.check_for_character(workspace !cactus.larsing.workspace, character_range_start !df.cell, character_range_end !df.cell, advance_on_found !df.cell, error !df.error)(workspace !cactus.larsing.workspace, ran_out_of_characters !df.cell, found !df.cell, not_found !df.cell, error !df.error) = {
    [ skip whitespace ]
    cactus.larse.skip_whitespace(workspace, error)(workspace, ran_out_of_characters, error)
    df.jump.bottom(ran_out_of_characters, @df.master_scope)()
    df.jump.bottom(error:occured, @df.master_scope)()

    [ get character ]
    df.address_to_cell(workspace:current_file:progress, df.ascii_character.byte_size)(character, advancement)
    
    [ check for character ]
    df.integer.within_range(character_range_start, character, character_range_end)(found, not_found)

    [ if should advance ]
    @advance advance_on_found = {
        [ was found ]
        @found found = {
            [ advance ]
            cactus.larse.advance_character(workspace, advancement, df.ascii_character.byte_size)(workspace)
        }
    }
}

[ advance current character ]
cactus.larse.advance_character(workspace !cactus.larsing.workspace, advancement !df.cell, length !df.cell)(workspace !cactus.larsing.workspace) = {
    [ advance current character ]
    df.copy(advancement)(workspace:current_file:progress)

    [ advance statistics ]
    df.integer.add(workspace:current_text_location:character_index, length)(workspace:current_text_location:character_index)
}

[ skip over whitespace ]
cactus.larse.skip_whitespace(workspace !cactus.larsing.workspace, error !df.error)(workspace !cactus.larsing.workspace, ran_out_of_characters !df.cell, error !df.error) = {
    [ setup characters ]
    df.set(df.integer.32)(whitespace.range.end)
    df.pack(df.constant.0, whitespace.range.end)(whitespace !df.buffer)
    df.set(df.hexadecimal.0A)(new_line)
    df.set(df.hexadecimal.5B)(left_square_bracket)
    df.set(df.hexadecimal.5D)(right_square_bracket)

    [ setup comment depth ]
    df.copy(df.constant.0)(comment_depth)

    [ loop over characters ]
    @skip_whitespace df.always = {
        [ make sure there are more characters to read ]
        df.current.within_range(workspace:current_file)(in_range, ran_out_of_characters)
        @ran_out_of_characters ran_out_of_characters = {
            [ check to see if a comment was not closed, if not then error ]
            df.integer.within_range(df.constant.0, comment_depth, df.constant.0)(closed, not_closed)
            @comment_not_closed not_closed = {
                [ raise error ]
                df.set("Larser Error: A nested comment was not closed all the way and ends abruptly at the current file's end.")(error_message)
                df.error.generate(error_message, workspace:current_text_location)(error)
            }

            [ jump ]
            df.jump.bottom(ran_out_of_characters, @df.master_scope)()
        }

        [ get character ]
        df.address_to_cell(workspace:current_file:progress, df.ascii_character.byte_size)(character, advancement)

        [ check if is new line ]
        df.integer.within_range(new_line, character, new_line)(in_range, out_of_range)
        @new_line_detected in_range = {
            [ advance line number marker ]
            df.integer.add(workspace:current_text_location:line_number, df.constant.1)(workspace:current_text_location:line_number)

            [ advance ]
            df.jump(in_range, @advance)()
        }

        [ check for left square bracket ]
        df.integer.within_range(left_square_bracket, character, left_square_bracket)(in_range, out_of_range)
        @left_square_bracket in_range = {
            [ increment comment depth ]
            df.integer.add(comment_depth, df.constant.1)(comment_depth)

            [ next character ]
            df.jump(in_range, @advance)()
        }
        
        [ check for right square bracket ]
        df.integer.within_range(right_square_bracket, character, right_square_bracket)(in_range, out_of_range)
        @right_square_bracket in_range = {
            [ check for comment depth error ]
            df.integer.within_range(df.constant.0, comment_depth, df.constant.0)(in_range, out_of_range)
            @right_square_bracket.underflow in_range = {
                [ raise error ]
                df.set("Larser Error: A comment depth underflow occured.")(error_message)
                df.error.generate(error_message, workspace:current_text_location)(error)

                [ exit loop ]
                df.jump.bottom(error:occured, @df.master_scope)()
            }

            [ decrement comment depth ]
            df.integer.subtract(comment_depth, df.constant.1)(comment_depth)

            [ next character ]
            df.jump(df.always, @advance)()
        }

        [ check if is not nested ]
        df.integer.within_range(df.constant.0, comment_depth, df.constant.0)(in_range, out_of_range)
        @nested_comment_remaining out_of_range = {
            df.jump(out_of_range, @advance)()
        }

        [ check if is normal whitespace ]
        df.integer.within_range(whitespace:start, character, whitespace:end)(in_range, out_of_range)
        @whitespace_remaining in_range = {
            df.jump(in_range, @advance)()
        }

        [ no more whitespace to skip ]
        df.jump.bottom(df.always, @df.master_scope)()

        [ advancement marker ]
        @advance

        [ advance current and statistics ]
        df.copy(advancement)(workspace:current_file:progress)
        df.integer.add(workspace:current_text_location:character_index, df.ascii_character.byte_size)(workspace:current_text_location:character_index)

        [ jump to start of loop ]
        df.jump.top(df.always, @skip_whitespace)()
    }
}

[
    Larser - Program Management
]

[ open larsling program ]
cactus.open.larsling.program()(program !cactus.larsling.program) = {
    [ setup baked data ]
    df.set(df.integer.2048)(multiplier)
    df.pack.null()(alias !cactus.larsling.alias)
    df.pack.null()(structure !cactus.larsling.structure)
    df.pack.null()(function !cactus.larsling.function)

    [ calculate increases ]
    df.structure.byte_size(alias)(alias.byte_size)
    df.structure.byte_size(structure)(structure.byte_size)
    df.structure.byte_size(function)(function.byte_size)
    df.integer.multiply(alias.byte_size, multiplier)(alias.increase)
    df.integer.multiply(structure.byte_size, multiplier)(structure.increase)
    df.integer.multiply(function.byte_size, multiplier)(function.increase)

    [ open lists ]
    df.list.open(alias.increase)(program:aliases)
    df.list.open(structure.increase)(program:structures)
    df.list.open(function.increase)(program:functions)
}

[
    Larser - List Appending
]

[ append larsling structure ]
cactus.list.append.larsling.structure(list !df.list, data !cactus.larsling.structure)(list !df.list) = {
    [ append members ]
    cactus.list.append.larsling.text(list, data:name)(list)
    df.list.append.list(list, data:members)(list)
}

[ append larsling alias ]
cactus.list.append.larsling.alias(list !df.list, data !cactus.larsling.alias)(list !df.list) = {
    [ append members ]
    cactus.list.append.larsling.text(list, data:old_name)(list)
    cactus.list.append.larsling.text(list, data:new_name)(list)
}

[ append larsling structure argument ]
cactus.list.append.larsling.structure.argument(list !df.list, data !cactus.larsling.structure.argument)(list !df.list) = {
    [ append members ]
    cactus.list.append.larsling.text(list, data:name)(list)
    cactus.list.append.larsling.text(list, data:type)(list)
}

[ append larsling text ]
cactus.list.append.larsling.text(list !df.list, data !cactus.larsling.text)(list !df.list) = {
    [ append members ]
    df.list.append.buffer(list, data:value)(list)
    df.list.append.text.location(list, data:location)(list)
}

[
    Larser - Printing
]

[ print an alias ]
cactus.larse.print.alias(alias !cactus.larsling.alias)() = {
    df.set("Alias: ")(message)
    df.print.buffer_as_string(message)()
    cactus.larse.print.text(alias:old_name)()
    cactus.larse.print.text(alias:new_name)()
}

[ print text ]
cactus.larse.print.text(text !cactus.larsling.text)() = {
    [ setup strings ]
    df.set("[ ")(header)
    df.set(", ")(separator)
    df.set(" ]")(footer)
    df.set("%22;")(double_quote)

    [ print data ]
    df.print.buffer_as_string(header)()
    df.print.buffer_as_string(double_quote)()
    df.print.buffer_as_string(text:value)()
    df.print.buffer_as_string(double_quote)()
    df.print.buffer_as_string(separator)()
    df.print.buffer_as_string(header)()
    df.print.integer.unsigned(text:location:file_index)()
    df.print.buffer_as_string(separator)()
    df.print.integer.unsigned(text:location:line_number)()
    df.print.buffer_as_string(separator)()
    df.print.integer.unsigned(text:location:character_index)()
    df.print.buffer_as_string(footer)()
    df.print.buffer_as_string(footer)()
}

[ print a structure ]
cactus.larse.print.structure(structure !cactus.larsling.structure)() = {
    [ setup strings ]
    df.set("Structure: !")(header)
    df.set(" = (%0a;")(middle)
    df.set(")%0a;")(footer)

    [ calculate byte sizes ]
    df.pack.null()(dummy.structure.argument !cactus.larsling.structure.argument)
    df.structure.byte_size(dummy.structure.argument)(argument.byte_size)

    [ print header ]
    df.print.buffer_as_string(header)()
    cactus.larse.print.text(structure:name)()
    df.print.buffer_as_string(middle)()

    [ setup current ]
    df.current.calculate.current_from_list(structure:members)(current)

    [ setup structure member (argument) loop ]
    @loop df.always = {
        [ check for more arguments ]
        df.current.within_range(current)(in_range, out_of_range)
        df.jump.bottom(out_of_range, @loop)()

        [ get argument ]
        df.buffer.calculate.end_address(current:progress, argument.byte_size)(current_argument.end)
        df.pack(current:progress, current_argument.end)(current_argument.as_buffer !df.buffer)
        df.buffer_to_structure(current_argument.as_buffer)(argument !cactus.larsling.structure.argument)

        [ print argument ]
        df.print.tabs(df.constant.1)()
        cactus.larse.print.structure.argument(argument)()
        df.print.new_line()()

        [ advance current ]
        df.integer.add(current:progress, argument.byte_size)(current:progress)

        [ next item ]
        df.jump.top(df.always, @loop)()
    }

    [ print footer ]
    df.print.buffer_as_string(footer)()
}

[ print a structure argument ]
cactus.larse.print.structure.argument(argument !cactus.larsling.structure.argument)() = {
    [ print name ]
    cactus.larse.print.text(argument:name)()

    [ print separator ]
    df.set(" !")(separator)
    df.print.buffer_as_string(separator)()

    [ print type ]
    cactus.larse.print.text(argument:type)()
}

[
    Larsing - Types
]

[ larsling program - all larsable language features ]
!cactus.larsling.program(
    aliases !df.list #cactus.larsling.alias,
    structures !df.list #cactus.larsling.structure,
    functions !df.list #cactus.larsling.function
)

[ larsling structure - a structure ]
!cactus.larsling.structure(
    name !cactus.larsling.text,
    members !df.list #cactus.larsling.structure.argument
)

[ larsling alias - a new name given to a structure (does not include functions) ]
!cactus.larsling.alias(
    old_name !cactus.larsling.text,
    new_name !cactus.larsling.text
)

[ larsling function - a function ]
!cactus.larsling.function(
    name !cactus.larsling.text,
    inputs !df.list #cactus.larsling.function.argument,
    outputs !df.list #cactus.larsling.function.argument,
    scope !cactus.larsling.scope
)

[ larsling function header argument ]
!cactus.larsling.function.argument(
    name !cactus.larsling.text,
    type !cactus.larsling.text [ optional ]
)

[ larsling structure member argument ]
!cactus.larsling.structure.argument(
    name !cactus.larsling.text,
    type !cactus.larsling.text
)

[ larsling scope ]
!cactus.larsling.scope(
    name !cactus.larsling.text,
    condition !cactus.larsling.statement.argument,
    statements !df.list #cactus.larsling.statement
)

[ larsling statement ]
!cactus.larsling.statement(
    [ type ]
    type !df.cell #cactus.larsling.statement.type,

    [ value ]
    call !cactus.larsling.statement.call,
    offset !cactus.larsling.statement.offset,
    scope !cactus.larsling.scope
)

[ larsling function call ]
!cactus.larsling.statement.call(
    name !cactus.larsling.text,
    inputs !df.list #cactus.larsling.statement.argument,
    outputs !df.list #cactus.larsling.statement.argument
)

[ larsling statement arguments (at least one of either name, type, offset or string must be present) ]
!cactus.larsling.statement.argument(
    [ the type of argument ]
    argument_type !df.cell,

    [ the argument itself ]
    namespace !cactus.larsling.statement.namespace [ optional ],
    string !cactus.larsling.text, [ optional ]
    structure_type !cactus.larsling.text, [ optional ]
    offset !cactus.larsling.statement.offset [ optional ]
)

[ a name / member searcher ]
!cactus.larsling.statement.namespace(
    names !df.list #cactus.larsling.text
)

[ larsling offset ]
!cactus.larsling.statement.offset(
    name !cactus.larsling.text,
    jump_extension !cactus.larsling.text [ optional ]
)

[ text ]
!cactus.larsling.text(
    value !df.buffer,
    location !df.text.location
)

[ statement types ]
!cactus.larsling.statement.types(
    call !df.cell,
    offset !df.cell,
    scope !df.cell
)

[ argument types ]
!cactus.larsling.statement.arguments.types(
    namespace !df.cell,
    string !df.cell,
    structure_type !df.cell
)
